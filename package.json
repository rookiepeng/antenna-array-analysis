{
  "name": "beamscope",
  "version": "3.0.0",
  "description": "A GUI tool for visualizing and computing antenna array beam patterns",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "tsc && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "author": "Zhengyu Peng",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.4",
    "@types/plotly.js": "^3.0.14",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "^26.8.1",
    "gif-encoder-2": "^1.0.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "plotly.js-dist-min": "^4.1.2"
  },
  "build": {
    "appId": "com.rookiepeng.beamscope",
    "productName": "BeamScope",
    "files": [
      "dist/**/*",
      "src/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/bridge",
        "to": "bridge"
      }
    ],
    "squirrelWindows": {
      "loadingGif": "res/install-spinner.gif"
    },
    "win": {
      "target": "squirrel",
      "icon": "res/beamscope_icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "res/beamscope_icon.icns"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
